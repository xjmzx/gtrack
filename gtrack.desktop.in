[Desktop Entry]
Type=Application
Version=1.0
Name=gtrack
GenericName=Git Checkout Tracker
Comment=Read-only view of the git checkouts on this machine — versions, releases and repo health (ndisc suite)
Exec=@BINDIR@/gtrack
Icon=@ICONDIR@/gtrack.svg
Terminal=false
Categories=Development;RevisionControl;
Keywords=git;repository;checkout;version;tag;release;status;ndisc;
StartupNotify=true
